# M1 配置语法为逐行 key=value；空行和以 # 开头的行会被忽略。
# 优先级：内建默认值 < 配置文件 < 后出现的 --set KEY=VALUE。
# 复制为 gateway.conf 后填写本地参数；该文件已被 Git 忽略。

device_id=imx6ull-gateway-lab
can_interface=can0

# example.invalid 是保留域名，不代表真实局域网 Broker。
broker_host=broker.example.invalid
broker_port=1883
broker_username=
broker_password=
mqtt_topic=vehicle/imx6ull-gateway-lab/telemetry

queue_capacity=1024
queue_push_timeout_ms=50
batch_interval_ms=1000
mqtt_ack_timeout_ms=5000
mqtt_reconnect_interval_ms=1000
spool_path=/var/lib/gatewayd/spool.data
# legacy 保留 M7/M8/M9 GSP1/GST1；启用 v2 时必须改成全新专用目录。
spool_format=legacy
spool_max_bytes=268435456
# 默认 1 保留逐条同步；M10 后续显式候选为 128 条或 1000 ms，以先到者为准。
spool_sync_records=1
spool_sync_interval_ms=1000
log_level=info
